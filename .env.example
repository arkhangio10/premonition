# Copia este archivo como .env y no lo subas a Git.
# Sin clave la aplicación funciona en simulación y muestra Meta como "sin clave".
MODEL_API_KEY=

# Límites por proceso: llamadas y presupuesto estimado, incluyendo reservas pendientes.
PREMONITION_MAX_META_CALLS=20
PREMONITION_MAX_META_USD=1.00

# Alias SSH existente hacia la Jetson. No desactivar la verificación del host.
PREMONITION_JETSON_HOST=jetson-usb
